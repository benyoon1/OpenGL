{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake configure debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=TRUE",
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build/debug",
        "-G",
        "Ninja"
      ]
    },
    {
      "label": "cmake configure release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=TRUE",
        "-S",
        "${workspaceFolder}",
        "-B",
        "${workspaceFolder}/build/release",
        "-G",
        "Ninja"
      ]
    },
    {
      "label": "build debug",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "${workspaceFolder}/build/debug", "--target", "all"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["cmake configure debug"]
    },
    {
      "label": "build release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/build/release",
        "--target",
        "all"
      ],
      "dependsOn": ["cmake configure release"]
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "rm",
      "args": ["-rf", "${workspaceFolder}/build"],
      "problemMatcher": []
    },
    {
      "label": "rebuild",
      "dependsOn": ["clean", "build debug"],
      "dependsOrder": "sequence"
    }
  ]
}
